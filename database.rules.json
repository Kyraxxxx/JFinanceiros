{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$collection": {
          "$record": {
            ".validate": "newData.hasChildren(['createdAt'])",
            "createdAt": {
              ".validate": "newData.isNumber() || newData.val() == now"
            },
            "amount": {
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)"
            },
            "quantity": {
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000)"
            },
            "progress": {
              ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
            }
          }
        }
      }
    },
    "access": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'railanebastossouza@gmail.com')",
        ".write": "auth != null && auth.token.email === 'railanebastossouza@gmail.com'"
      }
    },
    "accessRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'railanebastossouza@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'railanebastossouza@gmail.com')",
        ".validate": "newData.hasChildren(['uid', 'email', 'status', 'requestedAt']) && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending'"
      }
    }
  }
}
